  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
